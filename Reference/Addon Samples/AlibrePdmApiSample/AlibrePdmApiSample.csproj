<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{D569D0D7-B9EE-4D70-94C9-7B1964A9988B}</ProjectGuid>
    <!-- A managed Alibre add-on: a class library loaded into Alibre Design.exe. -->
    <OutputType>Library</OutputType>
    <RootNamespace>AlibrePdmApiSample</RootNamespace>
    <AssemblyName>AlibrePdmApiSample</AssemblyName>
    <!-- Alibre Design.exe.config declares sku .NETFramework,Version=v4.8; match the host. -->
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>7.3</LangVersion>
    <!-- Alibre's AlibreX / AlibreAddOn interop assemblies are AMD64-only, and the
         add-on only ever runs inside 64-bit Alibre. -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Alibre's Program folder, for the AlibreX / AlibreAddOn interop assemblies.
         Override on the command line: /p:AlibreProgramDir=... -->
    <AlibreProgramDir Condition=" '$(AlibreProgramDir)' == '' ">C:\Program Files\Alibre Design 29.1.0.29126\Program</AlibreProgramDir>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <!-- Private=False: Alibre already has these loaded; never ship copies. -->
    <Reference Include="AlibreAddOn">
      <HintPath>$(AlibreProgramDir)\AlibreAddOn.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AlibreX">
      <HintPath>$(AlibreProgramDir)\AlibreX.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="AlibreAddOn.cs" />
    <Compile Include="ClassDataItemOption.cs" />
    <Compile Include="ContainerItem.cs" />
    <Compile Include="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <Compile Include="PdmApiSampleAddOn.cs" />
    <Compile Include="PDMTaskCallback.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="PropertyEditDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="PropertyEditDialog.Designer.cs">
      <DependentUpon>PropertyEditDialog.cs</DependentUpon>
    </Compile>
    <Compile Include="PropertyItem.cs" />
    <Compile Include="WindowWrapper.cs" />
    <EmbeddedResource Include="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <Compile Include="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <None Include="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Compile Include="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!-- The deploy folder: bin\<Config>\ is packaged as-is by tools\New-AlibreAddonPackage.ps1. -->
    <Content Include="AlibrePdmApiSample.adc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="AlibrePdmApiSample.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="addon.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="New-PdmSampleIcon.ps1" />
    <None Include="catalog\**\*" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
