<AlibreDesignAddOn specificationVersion="2" friendlyName="Advanced Sweep Generator">
   <Author name="David Bolsover" link="https://github.com/bolsover/AlibreAddInManager"/>
   <Copyright>Copyright (c) 2026. David Bolsover</Copyright>
   <DLL type="Managed" loadedWhen="Startup" location="AdvancedSweepGenerator.dll"/>
   <Icon location="AdvancedSweepGenerator.ico"/>
   <Menu text="Advanced Sweep"/>
   <Description>Sweeps a circular or square profile, solid or hollow, along a 2D or 3D path sketch. The profile plane and sketch are created automatically at the start of the path.</Description>
   <Workspace type="Always"/>
   <Property name="Identifier" value="{D23F2FF2-09A0-46B9-9D84-532C8561CFD5}"/>
</AlibreDesignAddOn>
