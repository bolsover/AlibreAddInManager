<UserControl x:Class="AlibreCatalogManager.Ui.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:AlibreCatalogManager.Ui">
    <UserControl.Resources>
        <!-- Rows carry their own colour: errors red, unlisted add-ons and info grey. -->
        <Style x:Key="ColouredRow" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{Binding Foreground}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <Button Content="New…" Style="{StaticResource ToolBarButton}" Click="OnNew"
                        ToolTip="Create an empty catalog in a folder"/>
                <Button Content="Open…" Style="{StaticResource ToolBarButton}" Click="OnOpen"
                        ToolTip="Open a catalog's index.json"/>
                <Button x:Name="ReloadButton" Content="Reload" Style="{StaticResource ToolBarButton}" Click="OnReload"
                        ToolTip="Discard edits and read the catalog again"/>
                <Button x:Name="SaveButton" Content="Save" Style="{StaticResource ToolBarButton}" Click="OnSave"/>
                <Separator/>
                <Button x:Name="AddAddOnButton" Content="Add add-on ▾" Style="{StaticResource ToolBarButton}" Click="OnShowMenu">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="From package (.alibreaddon)…" Click="OnAddAddOnFromPackage"/>
                            <MenuItem Header="From build folder…" Click="OnAddAddOnFromFolder"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="AddVersionButton" Content="Add version ▾" Style="{StaticResource ToolBarButton}" Click="OnShowMenu">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="From package (.alibreaddon)…" Click="OnAddVersionFromPackage"/>
                            <MenuItem Header="From build folder…" Click="OnAddVersionFromFolder"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="ListToggleButton" Content="Remove from listing" Style="{StaticResource ToolBarButton}" Click="OnToggleListed"/>
                <Button x:Name="DeleteButton" Content="Delete…" Style="{StaticResource ToolBarButton}" Click="OnDelete"/>
                <Separator/>
                <Button x:Name="CheckButton" Content="Check catalog" Style="{StaticResource ToolBarButton}" Click="OnCheck"
                        ToolTip="Check the catalog the way the manager will read it, including package contents"/>
                <Separator/>
                <Label Content="_Search:" Target="{Binding ElementName=SearchBox}" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchBox" Width="160" Margin="0" TextChanged="OnSearchChanged"/>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="150"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="150" MinHeight="60"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430" MinWidth="200"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <ListView x:Name="AddOnList" SelectionMode="Single" ItemContainerStyle="{StaticResource ColouredRow}"
                          SelectionChanged="OnAddOnSelected">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="170" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Latest" Width="60" DisplayMemberBinding="{Binding Latest}"/>
                            <GridViewColumn Header="Publisher" Width="110" DisplayMemberBinding="{Binding Publisher}"/>
                            <GridViewColumn Header="Status" Width="70" DisplayMemberBinding="{Binding Status}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="100"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*" MinHeight="100"/>
                    </Grid.RowDefinitions>

                    <Border BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                        <ui:PropertyEditor x:Name="AddOnEditorView"/>
                    </Border>

                    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" MinWidth="150"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel>
                            <ToolBar DockPanel.Dock="Top" ToolBarTray.IsLocked="True">
                                <TextBlock Text="Versions" VerticalAlignment="Center" Margin="4,0"/>
                                <Separator/>
                                <Button x:Name="RemoveVersionButton" Content="Remove version…" Style="{StaticResource ToolBarButton}" Click="OnRemoveVersion"/>
                                <Button x:Name="RehashButton" Content="Rehash" Style="{StaticResource ToolBarButton}" Click="OnRehash"/>
                            </ToolBar>
                            <ListView x:Name="VersionList" SelectionMode="Single" SelectionChanged="OnVersionSelected">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Version" Width="70" DisplayMemberBinding="{Binding Number}"/>
                                        <GridViewColumn Header="Released" Width="80" DisplayMemberBinding="{Binding Released}"/>
                                        <GridViewColumn Header="Builds" Width="90" DisplayMemberBinding="{Binding Builds}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

                        <Border Grid.Column="2" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                            <ui:PropertyEditor x:Name="VersionEditorView"/>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Text="Problems — double-click to go to the add-on" Margin="2,4,0,2"/>
                <ListView x:Name="ProblemList" SelectionMode="Single" ItemContainerStyle="{StaticResource ColouredRow}"
                          MouseDoubleClick="OnProblemDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Severity" Width="70" DisplayMemberBinding="{Binding Severity}"/>
                            <GridViewColumn Header="Add-on" Width="170" DisplayMemberBinding="{Binding AddOn}"/>
                            <GridViewColumn Header="Problem" Width="600" DisplayMemberBinding="{Binding Message}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
