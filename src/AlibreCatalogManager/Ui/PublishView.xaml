<UserControl x:Class="AlibreCatalogManager.Ui.PublishView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Project -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="1. Project" Style="{StaticResource Heading}" Margin="0,0,0,4"/>

            <Label Grid.Row="1" Content="Pro_ject:" Target="{Binding ElementName=ProjectBox}" Style="{StaticResource FormLabel}"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ProjectBox" LostFocus="OnProjectLostFocus" KeyDown="OnProjectKeyDown"
                     ToolTip="An add-on project (.csproj or C++ .vcxproj) with addon.json beside it, e.g. one made on the New Add-On tab."/>
            <Button Grid.Row="1" Grid.Column="2" x:Name="BrowseProjectButton" Content="Browse…" Click="OnBrowseProject"/>

            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ProjectInfo" Style="{StaticResource Hint}"/>

            <Label Grid.Row="3" Content="_Version:" Target="{Binding ElementName=VersionBox}" Style="{StaticResource FormLabel}"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="VersionBox" Width="100" HorizontalAlignment="Left"
                     ToolTip="Version to package. If you change it, addon.json and (if present) Properties\AssemblyInfo.cs are updated before the build."/>

            <Label Grid.Row="4" Content="Con_figuration:" Target="{Binding ElementName=ConfigurationBox}" Style="{StaticResource FormLabel}"/>
            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="ConfigurationBox" Width="100" HorizontalAlignment="Left" SelectedIndex="0">
                <ComboBoxItem Content="Release"/>
                <ComboBoxItem Content="Debug"/>
            </ComboBox>

            <Label Grid.Row="5" Content="_MSBuild:" Target="{Binding ElementName=MsBuildBox}" Style="{StaticResource FormLabel}"/>
            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="MsBuildBox" IsEditable="True"
                      ToolTip="MSBuild.exe from Visual Studio, Build Tools or Rider."/>
            <Button Grid.Row="5" Grid.Column="2" x:Name="BrowseMsBuildButton" Content="Browse…" Click="OnBrowseMsBuild"/>

            <CheckBox Grid.Row="6" Grid.Column="1" x:Name="BuildFirstBox" Content="Build the project before packaging" IsChecked="True"
                      ToolTip="Untick to package the existing build output as it is."/>

            <!-- 2. Package -->
            <TextBlock Grid.Row="7" Grid.ColumnSpan="3" Text="2. Package" Style="{StaticResource Heading}"/>

            <Label Grid.Row="8" Content="Package _folder:" Target="{Binding ElementName=PackageFolderBox}" Style="{StaticResource FormLabel}"/>
            <TextBox Grid.Row="8" Grid.Column="1" x:Name="PackageFolderBox"
                     ToolTip="The package is written here as &lt;folderName&gt;-&lt;version&gt;.alibreaddon."/>
            <Button Grid.Row="8" Grid.Column="2" x:Name="BrowsePackageButton" Content="Browse…" Click="OnBrowsePackageFolder"/>

            <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="PackButton" Content="_Build &amp; package" Margin="0,3,0,3" Click="OnBuildAndPackage"/>
                <Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Click="OnCancel"/>
                <Button x:Name="ShowPackageButton" Content="Show package" Click="OnShowPackage"/>
            </StackPanel>

            <TextBlock Grid.Row="10" Grid.Column="1" x:Name="PackageInfo" TextWrapping="Wrap" Margin="0,3"/>

            <!-- 3. Publish -->
            <TextBlock Grid.Row="11" Grid.ColumnSpan="3" Text="3. Publish" Style="{StaticResource Heading}"/>

            <Label Grid.Row="12" Content="Catalog:" Style="{StaticResource FormLabel}"/>
            <TextBlock Grid.Row="12" Grid.Column="1" x:Name="CatalogInfo" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="12" Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="OpenCatalogButton" Content="Open…" Click="OnOpenCatalog"/>
                <Button x:Name="NewCatalogButton" Content="New…" Click="OnNewCatalog"/>
            </StackPanel>

            <Label Grid.Row="13" Content="Release _notes:" Target="{Binding ElementName=ReleaseNotesBox}" Style="{StaticResource FormLabel}"
                   VerticalAlignment="Top"/>
            <TextBox Grid.Row="13" Grid.Column="1" x:Name="ReleaseNotesBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     ToolTip="Optional; stored with the new version in the catalog manifest."/>

            <Button Grid.Row="14" Grid.Column="1" x:Name="PublishButton" Content="_Publish to catalog" HorizontalAlignment="Left"
                    Margin="0,3,0,3" Click="OnPublish"
                    ToolTip="Adds the package to the open catalog (as a new add-on, or a new version of an existing one) and saves. The package is copied to the catalog's packages folder; to host it elsewhere, edit the version's PackageUrl on the Catalog tab."/>
        </Grid>

        <TextBlock DockPanel.Dock="Top" Text="Output" Margin="0,8,0,2"/>
        <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" VerticalContentAlignment="Top" Margin="0"/>
    </DockPanel>
</UserControl>
