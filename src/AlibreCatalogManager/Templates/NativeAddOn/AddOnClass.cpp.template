HRESULT %%AddOnName%%AddOn::get_RootMenuItem(long* pRootMenuID)
{
    if (pRootMenuID == nullptr) return E_POINTER;
    *pRootMenuID = MenuIdRoot;
    return S_OK;
}

HRESULT %%AddOnName%%AddOn::HasSubMenus(long menuID, VARIANT_BOOL* pHasSubMenus)
{
    if (pHasSubMenus == nullptr) return E_POINTER;
    *pHasSubMenus = menuID == MenuIdRoot ? VARIANT_TRUE : VARIANT_FALSE;
    return S_OK;
}

HRESULT %%AddOnName%%AddOn::SubMenuItems(long menuID, SAFEARRAY** pSubMenuIDs)
{
    if (pSubMenuIDs == nullptr) return E_POINTER;
    const ULONG count = menuID == MenuIdRoot ? 1 : 0;
    *pSubMenuIDs = SafeArrayCreateVector(VT_I4, 0, count);
    if (*pSubMenuIDs == nullptr) return E_OUTOFMEMORY;
    if (count > 0)
    {
        LONG index = 0;
        long id = MenuIdCommand;
        SafeArrayPutElement(*pSubMenuIDs, &index, &id);
    }
    return S_OK;
}

HRESULT %%AddOnName%%AddOn::MenuItemText(long menuID, BSTR* pMenuDisplayText)
{
    switch (menuID)
    {
    case MenuIdRoot: return ReturnString(L"%%MenuText%%", pMenuDisplayText);
    case MenuIdCommand: return ReturnString(Title, pMenuDisplayText);
    default: return ReturnString(L"", pMenuDisplayText);
    }
}

HRESULT %%AddOnName%%AddOn::PopupMenu(long menuID, VARIANT_BOOL* pIsPopup)
