HRESULT %%AddOnName%%AddOn::MenuItemState(long menuID, BSTR, enum ADDONMenuStates* pType)
{
    if (pType == nullptr) return E_POINTER;
    // The root stays enabled so the drop-down (and the tooltip explaining
    // why the command is greyed) can always be opened.
    if (menuID == MenuIdRoot)
        *pType = ADDONMenuStates_ADDON_MENU_ENABLED;
    else
        *pType = menuID == MenuIdCommand && IsSupportedVersion() ? ADDONMenuStates_ADDON_MENU_ENABLED : ADDONMenuStates_ADDON_MENU_GRAYED;
    return S_OK;
}

HRESULT %%AddOnName%%AddOn::MenuItemToolTip(long menuID, BSTR* pToolTip)
{
    return ReturnString(menuID == MenuIdCommand ? CommandToolTip() : std::wstring(), pToolTip);
}

HRESULT %%AddOnName%%AddOn::InvokeCommand(long menuID, BSTR, IAlibreAddOnCommand** pCommand)
{
    if (pCommand == nullptr) return E_POINTER;
    *pCommand = nullptr;
    if (menuID == MenuIdCommand) RunCommand(_parentWindow);
    return S_OK;
}

// The command's work. Called by InvokeCommand from the add-on's menu%%#HomeWorkspace%%, and by
// the AddOnInvoke export when the add-on is launched from the Home window%%/HomeWorkspace%%.
void %%AddOnName%%AddOn::RunCommand(HWND owner)
{
    // No exception may escape into Alibre.
    try
    {
        if (!IsSupportedVersion())
        {
            MessageBoxW(owner, CommandToolTip().c_str(), Title, MB_OK | MB_ICONWARNING);
            return;
        }

        // TODO: the add-on's work goes here.
        const std::wstring message = std::wstring(Title) + L" is running in Alibre Design " +
                                     AlibreVersion::GetVersion(_root) + L".";
        MessageBoxW(owner, message.c_str(), Title, MB_OK | MB_ICONINFORMATION);
    }
    catch (const _com_error& e)
    {
        const _bstr_t description = e.Description();
        const std::wstring message = description.length() > 0 ? static_cast<const wchar_t*>(description) : e.ErrorMessage();
        MessageBoxW(owner, message.c_str(), Title, MB_OK | MB_ICONERROR);
    }
    catch (const std::exception& e)
    {
        MessageBoxW(owner, Widen(e.what()).c_str(), Title, MB_OK | MB_ICONERROR);
    }
}

