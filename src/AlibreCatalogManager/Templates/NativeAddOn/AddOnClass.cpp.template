namespace
{
    HRESULT ReturnString(const std::wstring& text, BSTR* result)
    {
        if (result == nullptr) return E_POINTER;
        *result = SysAllocString(text.c_str());
        return *result != nullptr ? S_OK : E_OUTOFMEMORY;
    }

    std::wstring Widen(const char* text)
    {
        const int length = MultiByteToWideChar(CP_ACP, 0, text, -1, nullptr, 0);
        if (length <= 1) return std::wstring();
        std::wstring result(static_cast<size_t>(length - 1), L'\0');
        MultiByteToWideChar(CP_ACP, 0, text, -1, &result[0], length);
        return result;
    }
}

%%AddOnName%%AddOn::%%AddOnName%%AddOn(IADRoot* root, HWND parentWindow)
    : _root(root), _parentWindow(parentWindow), _build(AlibreVersion::GetBuild(root))
{
}

std::wstring %%AddOnName%%AddOn::CommandToolTip() const
{
    if (!IsSupportedVersion())
        return L"Requires Alibre Design build " + std::to_wstring(AlibreVersion::MinimumBuild) +
               L" or later (this is build " + std::to_wstring(_build) + L")";
    return L"%%Description%%";
}

// IUnknown

HRESULT %%AddOnName%%AddOn::QueryInterface(REFIID riid, void** ppvObject)
{
    if (ppvObject == nullptr) return E_POINTER;
    if (riid == IID_IUnknown || riid == IID_IDispatch || riid == __uuidof(IAlibreAddOn))
    {
        *ppvObject = static_cast<IAlibreAddOn*>(this);
        AddRef();
        return S_OK;
    }

    *ppvObject = nullptr;
    return E_NOINTERFACE;
}

ULONG %%AddOnName%%AddOn::AddRef()
{
    return static_cast<ULONG>(InterlockedIncrement(&_refCount));
}

ULONG %%AddOnName%%AddOn::Release()
{
    const auto count = InterlockedDecrement(&_refCount);
    if (count == 0) delete this;
    return static_cast<ULONG>(count);
}

